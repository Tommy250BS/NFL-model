import pandas as pd
from copy import deepcopy
from nfl_model import *

# Seed globale: rende riproducibili sia la valutazione storica sia il Monte Carlo.
set_seed(42)

# =========================
# LOAD TEAMS (ROBUST)
# =========================
teams_df = pd.read_csv("teams.csv")

# CLEAN COLUMN NAMES
teams_df.columns = (
    teams_df.columns
    .str.strip()
    .str.lower()
)

print("Teams CSV columns:", list(teams_df.columns))

# CLEAN TEAM NAMES
teams_df["name"] = teams_df["name"].str.strip()
teams_df["conference"] = teams_df["conference"].str.strip()
teams_df["division"] = teams_df["division"].str.strip()

# CREATE TEAM OBJECTS
teams = {}
for _, row in teams_df.iterrows():
    teams[row["name"]] = Team(
        name=row["name"],
        conference=row["conference"],
        division=row["division"]
    )

# =========================
# LOAD GAMES (ROBUST)
# =========================
season_df = pd.read_csv("games_2024.csv")

season_df.columns = (
    season_df.columns
    .str.strip()
    .str.lower()
    .str.replace(" ", "_")
)

print("Games CSV columns:", list(season_df.columns))

# CLEAN TEAM NAMES
season_df["home_team"] = season_df["home_team"].str.strip()
season_df["away_team"] = season_df["away_team"].str.strip()

# =========================
# CHECK FOR MISSING TEAMS
# =========================
missing_home = season_df[season_df["home_team"] == ""]
missing_away = season_df[season_df["away_team"] == ""]

print("ROWS WITH MISSING HOME TEAM:")
print(missing_home)

print("ROWS WITH MISSING AWAY TEAM:")
print(missing_away)

# =========================
# WALK-FORWARD: VALUTAZIONE STORICA (deterministica)
# =========================
predictions, records = evaluate_historical_season(
    season_df,
    deepcopy(teams)
)

print("\nMODEL QUALITY")
print("Log Loss:", log_loss(predictions))
print("Brier Score:", brier_score(predictions))

# =========================
# REGULAR SEASON STANDINGS
# =========================
for conf in ["AFC", "NFC"]:
    conf_teams = [t for t in teams.values() if t.conference == conf]
    seeds = seed_conference(conf_teams, records, season_df)

    print(f"\n{conf} PLAYOFF SEEDS")
    for i, t in enumerate(seeds, 1):
        r = records[t.name]
        record_str = f"{r.wins}-{r.losses}" + (f"-{r.ties}" if r.ties else "")
        print(f"{i}. {t.name}  {record_str}  PD: {r.point_diff}")

# =========================
# MONTE CARLO SUPER BOWL
# =========================
# use_actual_results_if_available=False: replica l'intera stagione in modo
# stocastico (i risultati NON vengono presi dai punteggi reali, ma campionati
# dal modello) -> risponde a "quanto e' stato determinato dalla fortuna il
# risultato reale?" Se invece games_2024.csv contenesse partite future con
# home_points/away_points mancanti (NaN), passare True darebbe una proiezione
# "resto della stagione" che usa i risultati reali gia' noti.
sb_probs = monte_carlo_season(
    teams,
    season_df,
    n_simulations=5000,
    output_file="superbowl_probs.csv",  # file will be created automatically
    use_actual_results_if_available=False,
    seed=42,
)

print("\nSUPER BOWL WIN PROBABILITIES")
for team, prob in sorted(sb_probs.items(), key=lambda x: -x[1]):
    print(f"{team}: {prob:.3f}")

print("\nSuper Bowl probabilities also saved to 'superbowl_probs.csv'")
